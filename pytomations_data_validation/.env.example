# ===== Oracle - source of truth =====
# Use ORACLE_CONNECTION_MODE=oracledb for thin-driver connections, or "odbc"
# for ORACLE_ODBC_DSN / ORACLE_ODBC_CONN_STR. For local Oracle Free, target
# 127.0.0.1:1521/FREEPDB1 with local-only credentials. Production use requires
# deliberately replacing these settings.
ORACLE_CONNECTION_MODE=odbc
ORACLE_DBAPI_DSN=
ORACLE_ODBC_DSN=
ORACLE_USER=
ORACLE_PASSWORD=
# Optional full ODBC string (overrides DSN). Tokens %USER% / %PASSWORD% are substituted.
# e.g. Driver={Oracle in OraClient19Home1};Dbq=host:1521/SERVICE;Uid=%USER%;Pwd=%PASSWORD%;
ORACLE_ODBC_CONN_STR=
ORACLE_LOGIN_TIMEOUT=30
# Use ONE of the two (SELECT/WITH queries only)
ORACLE_QUERY=
ORACLE_TABLE=
# Needed for deterministic row order when KEY_COLUMNS is empty (used with ORACLE_TABLE)
ORACLE_ORDER_BY=

# ===== DAT file =====
# Placeholders {YYYYMMDD} / {YYYY-MM-DD} = today; wildcards (*) pick the newest match
DAT_FILE_PATH=data/export_{YYYYMMDD}.dat
DAT_SEPARATOR=|
DAT_ENCODING=utf-8-sig
DAT_HAS_HEADER=true
# Comma-separated columns dropped from DAT when not present in DB
DAT_IGNORE_COLUMNS=exported_date

# ===== Row matching =====
# Comma-separated key columns (primary/composite). Empty = compare by row position
KEY_COLUMNS=

# ===== Normalization =====
TRIM_WHITESPACE=true
CASE_INSENSITIVE=false
# Comma-separated tokens treated as NULL/empty (e.g. NULL,\N). Empty = none
NULL_TOKENS=
# Formats tried (in order) for DB date/timestamp columns when parsing DAT text
DATE_FORMATS=%Y-%m-%d,%Y-%m-%d %H:%M:%S,%Y-%m-%dT%H:%M:%S,%d-%b-%y,%d-%b-%Y,%d/%m/%Y,%Y/%m/%d,%Y%m%d,%Y-%m-%d %H:%M:%S.%f

# ===== Report =====
# Output: <REPORT_DIR>/<YYYY-MM-DD>/<REPORT_FILE_PREFIX>_<HHMMSS>.xlsx
REPORT_DIR=reports
REPORT_FILE_PREFIX=data_validation
